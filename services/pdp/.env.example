# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ATTRIBUTE_REGISTRY_ADDRESS=0x4004A83f8963B5943D08FE7FC4C3E550973C6362

# Optional (defaults shown)
PORT=4000
REDIS_URL=redis://localhost:6379
# Block number to start backfilling attribute events from. 0 scans the entire chain history —
# wasteful, and on a real deployment, likely to fail outright: public RPC nodes typically only
# retain recent history ("pruned history unavailable" errors mean you've asked for data older
# than the node keeps). Set this close to (at or before) the actual deployment block.
#
# To find it: try the Etherscan UI first (the contract's page -> "Contract Creation" tx ->
# block number). If that's not easy to locate, a reliable fallback is querying the current
# block directly and subtracting a safe buffer (a few days' worth of blocks comfortably covers
# any recent deployment without needing exactness):
#   curl -s -X POST $RPC_URL -H "Content-Type: application/json" \
#     -d '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}'
# Convert the hex result to decimal, subtract ~100000 (Sepolia produces ~7200 blocks/day, so
# this covers roughly a week), and use that as SYNC_FROM_BLOCK.
#
# Real value used for this project's actual Sepolia deployment (see deployments/sepolia.json):
SYNC_FROM_BLOCK=11445130
# Max block range per eth_getLogs request during backfill. Most RPC providers (including the
# public Sepolia endpoint this project defaults to) reject requests spanning more than some
# provider-specific maximum — the public endpoint used here enforces 50000; this default of
# 40000 stays safely under that. Lower this if your provider's limit is smaller (Etherscan's
# free API and some free-tier providers cap much lower, sometimes as low as 2000-10000).
SYNC_CHUNK_SIZE=40000
