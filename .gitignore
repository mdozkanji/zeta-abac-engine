# Dependencies
node_modules/

# Hardhat (root project only — leading slash anchors these to the repo root so they don't
# accidentally match legitimately-named subdirectories elsewhere, like services/pdp/src/cache/)
/artifacts/
/cache/
/typechain-types/

# Env / secrets — NEVER commit real keys
.env
.env.local

# Safety net for accidentally-saved key material (e.g. output copied from
# scripts/generate-governors.ts) — ideally such files live outside the repo entirely, but
# this catches the common mistake of saving them alongside the project.
*governor*.txt
*governer*.txt
*wallet*.txt
*private*key*
*secrets*.txt

# Build output
dist/
coverage/

# OS/editor noise
.DS_Store
*.log
.vscode/
