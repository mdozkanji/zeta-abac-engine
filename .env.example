# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Sepolia testnet RPC endpoint. Free options: Alchemy, Infura, or a public RPC like
# https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# Private key of the deployer account, WITHOUT the 0x prefix stripped or added inconsistently
# — match whatever format ethers expects (0x-prefixed hex). Use a dedicated throwaway testnet
# wallet, never a wallet holding real funds.
PRIVATE_KEY=

# Optional: for verifying deployed contracts on Etherscan (Week 4)
ETHERSCAN_API_KEY=

# Optional: for USD gas-cost conversion in the gas reporter — omit and it just shows
# gas units + ETH cost instead.
COINMARKETCAP_API_KEY=
